{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urdf.studio/specs/wsp/manifest-1.1.0.schema.json",
  "title": "World Scene Package Manifest",
  "type": "object",
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "positiveVector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "cameraPose": {
      "type": "object",
      "required": ["xyz", "rpy"],
      "additionalProperties": false,
      "properties": {
        "xyz": { "$ref": "#/$defs/vector3" },
        "rpy": { "$ref": "#/$defs/vector3" }
      }
    },
    "cameraIntrinsics": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fov_deg": { "type": "number", "minimum": 1, "maximum": 179 },
        "fx": { "type": "number", "exclusiveMinimum": 0 },
        "fy": { "type": "number", "exclusiveMinimum": 0 },
        "cx": { "type": "number" },
        "cy": { "type": "number" },
        "distortion": { "type": "object" }
      },
      "anyOf": [
        { "required": ["fov_deg"] },
        { "required": ["fx"] },
        { "required": ["fy"] }
      ]
    },
    "worldCamera": {
      "type": "object",
      "required": ["id", "name", "parent_joint", "pose", "intrinsics"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "parent_joint": { "type": "string", "minLength": 1 },
        "pose": { "$ref": "#/$defs/cameraPose" },
        "intrinsics": { "$ref": "#/$defs/cameraIntrinsics" }
      }
    },
    "positiveScale": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "$ref": "#/$defs/positiveVector3" }
      ]
    },
    "portableAssetRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*:)(?:\\./)*(?!\\.{1,2}(?:/|$))[^/]+(?:/(?!\\.{1,2}(?:/|$))[^/]+)*$"
    },
    "worldObjectSimulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixed": { "type": "boolean" },
        "collision": { "type": "boolean" },
        "mass_kg": { "type": ["number", "null"], "minimum": 0 },
        "friction": {
          "type": ["number", "null"],
          "minimum": 0.01,
          "maximum": 5
        },
        "restitution": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "semantic_role": { "type": ["string", "null"] }
      }
    },
    "worldObjectMesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_ref": { "$ref": "#/$defs/portableAssetRef" },
        "path": { "$ref": "#/$defs/portableAssetRef" },
        "uri": { "$ref": "#/$defs/portableAssetRef" },
        "filename": { "$ref": "#/$defs/portableAssetRef" },
        "scale": { "$ref": "#/$defs/positiveScale" },
        "scale_xyz": { "$ref": "#/$defs/positiveVector3" }
      }
    },
    "worldObjectAppearanceRepresentation": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["mesh", "primitive", "splat"] },
        "asset_ref": { "$ref": "#/$defs/portableAssetRef" },
        "scale_xyz": { "$ref": "#/$defs/positiveVector3" },
        "semantic_role": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["mesh", "splat"] } },
            "required": ["kind"]
          },
          "then": { "required": ["asset_ref"] }
        }
      ]
    },
    "worldObjectAppearance": {
      "type": "object",
      "required": ["representations"],
      "additionalProperties": false,
      "properties": {
        "representations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/worldObjectAppearanceRepresentation" }
        }
      }
    },
    "worldObjectPhysicsCollisionGeometry": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["box", "sphere", "cylinder", "mesh"] },
        "asset_ref": { "$ref": "#/$defs/portableAssetRef" },
        "size_xyz": { "$ref": "#/$defs/positiveVector3" },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "scale_xyz": { "$ref": "#/$defs/positiveVector3" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "box" } },
            "required": ["kind"]
          },
          "then": { "required": ["size_xyz"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "sphere" } },
            "required": ["kind"]
          },
          "then": { "required": ["radius"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "cylinder" } },
            "required": ["kind"]
          },
          "then": { "required": ["radius", "length"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "mesh" } },
            "required": ["kind"]
          },
          "then": { "required": ["asset_ref"] }
        }
      ]
    },
    "worldObjectPhysicsInertia": {
      "type": "object",
      "required": ["ixx", "iyy", "izz"],
      "additionalProperties": false,
      "properties": {
        "ixx": { "type": "number", "minimum": 0 },
        "iyy": { "type": "number", "minimum": 0 },
        "izz": { "type": "number", "minimum": 0 },
        "ixy": { "type": "number" },
        "ixz": { "type": "number" },
        "iyz": { "type": "number" }
      }
    },
    "worldObjectPhysics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixed": { "type": "boolean" },
        "collision": { "type": "boolean" },
        "collision_geometry": { "$ref": "#/$defs/worldObjectPhysicsCollisionGeometry" },
        "mass_kg": { "type": ["number", "null"], "minimum": 0 },
        "inertia": { "$ref": "#/$defs/worldObjectPhysicsInertia" },
        "friction": {
          "type": ["number", "null"],
          "minimum": 0.01,
          "maximum": 5
        },
        "restitution": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "semantic_role": { "type": ["string", "null"] }
      }
    },
    "worldObjectConsistency": {
      "type": "object",
      "required": ["appearance_ref", "physics_ref", "method", "status"],
      "additionalProperties": false,
      "properties": {
        "appearance_ref": { "type": "string", "minLength": 1 },
        "physics_ref": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "metrics": { "type": "object" },
        "status": {
          "type": "string",
          "enum": ["valid", "warning", "missing", "unchecked"]
        }
      }
    },
    "worldObject": {
      "type": "object",
      "required": ["id", "name", "type", "position_xyz", "size_xyz", "color"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["cube", "point", "sphere", "cylinder", "mesh"]
        },
        "position_xyz": { "$ref": "#/$defs/vector3" },
        "rotation_rpy_rad": { "$ref": "#/$defs/vector3" },
        "size_xyz": { "$ref": "#/$defs/positiveVector3" },
        "color": { "type": "string", "minLength": 1 },
        "is_hidden": { "type": "boolean" },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "world-scenario",
            "demo-world"
          ]
        },
        "tracked_joint_name": { "type": ["string", "null"] },
        "is_ik_target": { "type": "boolean" },
        "ik_target_type": { "type": "string", "enum": ["punctual", "orbit"] },
        "orbit_radius": { "type": "number", "exclusiveMinimum": 0 },
        "orbit_inclination_deg": { "type": "number" },
        "orbit_phase_deg": { "type": "number" },
        "orbit_secondary_offset_deg": { "type": "number" },
        "orbit_target_point": {
          "type": "string",
          "enum": ["center", "primary", "secondary"]
        },
        "simulation": { "$ref": "#/$defs/worldObjectSimulation" },
        "appearance": { "$ref": "#/$defs/worldObjectAppearance" },
        "physics": { "$ref": "#/$defs/worldObjectPhysics" },
        "consistency": { "$ref": "#/$defs/worldObjectConsistency" },
        "asset_ref": { "$ref": "#/$defs/portableAssetRef" },
        "asset_scale_xyz": { "$ref": "#/$defs/positiveVector3" },
        "mesh": { "$ref": "#/$defs/worldObjectMesh" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "mesh" } },
            "required": ["type"]
          },
          "then": {
            "anyOf": [
              { "required": ["asset_ref"] },
              {
                "required": ["appearance"],
                "properties": {
                  "appearance": {
                    "properties": {
                      "representations": {
                        "contains": {
                          "type": "object",
                          "properties": {
                            "kind": { "enum": ["mesh", "splat"] }
                          },
                          "required": ["kind"]
                        }
                      }
                    },
                    "required": ["representations"]
                  }
                }
              },
              {
                "required": ["mesh"],
                "properties": {
                  "mesh": {
                    "anyOf": [
                      { "required": ["asset_ref"] },
                      { "required": ["path"] },
                      { "required": ["uri"] },
                      { "required": ["filename"] }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "appearance": {
                "properties": {
                  "representations": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "kind": { "const": "splat" }
                      },
                      "required": ["kind"]
                    }
                  }
                },
                "required": ["representations"]
              }
            },
            "required": ["appearance"]
          },
          "then": {
            "required": ["physics"],
            "properties": {
              "physics": {
                "required": ["collision_geometry"]
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "version",
    "title",
    "created_at",
    "runtime_targets",
    "interface",
    "artifacts",
    "world_snapshot",
    "provenance",
    "security"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"]
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_targets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["name", "mode"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["native", "python", "container"] },
          "min_version": { "type": "string" }
        }
      }
    },
    "interface": {
      "type": "object",
      "required": [
        "observation_modalities",
        "action_semantics",
        "timestep_ms",
        "frame_convention"
      ],
      "additionalProperties": true,
      "properties": {
        "observation_modalities": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "action_semantics": { "type": "string", "minLength": 1 },
        "timestep_ms": { "type": "integer", "minimum": 1 },
        "frame_convention": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["kind", "digest_sha256", "uri"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "digest_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "uri": { "type": "string", "minLength": 1 }
        }
      }
    },
    "world_snapshot": {
      "type": "object",
      "required": [
        "urdf_xml",
        "joint_positions",
        "cameras",
        "objects",
        "scenario_time_ms",
        "scenario_duration_ms"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "scenario_duration_ms": { "const": 0 } },
            "required": ["scenario_duration_ms"]
          },
          "then": {
            "properties": { "scenario_time_ms": { "const": 0 } }
          }
        }
      ],
      "properties": {
        "urdf_xml": { "type": "string", "minLength": 1 },
        "joint_positions": {
          "type": "object",
          "maxProperties": 512,
          "additionalProperties": { "type": "number" }
        },
        "cameras": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/worldCamera" }
        },
        "objects": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/worldObject" }
        },
        "scenario_time_ms": { "type": "integer", "minimum": 0 },
        "scenario_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "security": {
      "type": "object",
      "required": ["attestation_refs"],
      "additionalProperties": false,
      "properties": {
        "signature_ref": { "type": ["string", "null"] },
        "attestation_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sbom_ref": { "type": ["string", "null"] }
      }
    }
  }
}
