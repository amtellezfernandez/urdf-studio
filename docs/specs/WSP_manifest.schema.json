{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urdf.studio/specs/wsp/manifest-1.0.0.schema.json",
  "title": "World Scene Package Manifest",
  "type": "object",
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "positiveVector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "positiveScale": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "$ref": "#/$defs/positiveVector3" }
      ]
    },
    "worldObjectSimulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixed": { "type": "boolean" },
        "collision": { "type": "boolean" },
        "mass_kg": { "type": ["number", "null"], "minimum": 0 },
        "friction": {
          "type": ["number", "null"],
          "minimum": 0.01,
          "maximum": 5
        },
        "restitution": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "semantic_role": { "type": ["string", "null"] }
      }
    },
    "worldObjectMesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_ref": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "scale": { "$ref": "#/$defs/positiveScale" },
        "scale_xyz": { "$ref": "#/$defs/positiveVector3" }
      }
    },
    "worldObject": {
      "type": "object",
      "required": ["id", "name", "type", "position_xyz", "size_xyz", "color"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["cube", "point", "sphere", "cylinder", "mesh"]
        },
        "position_xyz": { "$ref": "#/$defs/vector3" },
        "rotation_rpy_rad": { "$ref": "#/$defs/vector3" },
        "size_xyz": { "$ref": "#/$defs/positiveVector3" },
        "color": { "type": "string", "minLength": 1 },
        "is_hidden": { "type": "boolean" },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "world-scenario",
            "demo-world",
            "runtime-detection",
            "runtime-demo",
            "runtime-restricted-area",
            "runtime-trajectory"
          ]
        },
        "tracked_joint_name": { "type": ["string", "null"] },
        "is_ik_target": { "type": "boolean" },
        "ik_target_type": { "type": "string", "enum": ["punctual", "orbit"] },
        "orbit_radius": { "type": "number", "exclusiveMinimum": 0 },
        "orbit_inclination_deg": { "type": "number" },
        "orbit_phase_deg": { "type": "number" },
        "orbit_secondary_offset_deg": { "type": "number" },
        "orbit_target_point": {
          "type": "string",
          "enum": ["center", "primary", "secondary"]
        },
        "simulation": { "$ref": "#/$defs/worldObjectSimulation" },
        "asset_ref": { "type": "string", "minLength": 1 },
        "asset_scale_xyz": { "$ref": "#/$defs/positiveVector3" },
        "mesh": { "$ref": "#/$defs/worldObjectMesh" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "mesh" } },
            "required": ["type"]
          },
          "then": {
            "anyOf": [
              { "required": ["asset_ref"] },
              {
                "required": ["mesh"],
                "properties": {
                  "mesh": {
                    "anyOf": [
                      { "required": ["asset_ref"] },
                      { "required": ["path"] },
                      { "required": ["uri"] },
                      { "required": ["filename"] }
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "version",
    "title",
    "created_at",
    "runtime_targets",
    "interface",
    "artifacts",
    "world_snapshot",
    "provenance",
    "security"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_targets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["name", "mode"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["native", "python", "container"] },
          "min_version": { "type": "string" }
        }
      }
    },
    "interface": {
      "type": "object",
      "required": [
        "observation_modalities",
        "action_semantics",
        "timestep_ms",
        "frame_convention"
      ],
      "additionalProperties": true,
      "properties": {
        "observation_modalities": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "action_semantics": { "type": "string", "minLength": 1 },
        "timestep_ms": { "type": "integer", "minimum": 1 },
        "frame_convention": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["kind", "digest_sha256", "uri"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "digest_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "uri": { "type": "string", "minLength": 1 }
        }
      }
    },
    "world_snapshot": {
      "type": "object",
      "required": [
        "urdf_xml",
        "joint_positions",
        "cameras",
        "objects",
        "scenario_time_ms",
        "scenario_duration_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "urdf_xml": { "type": "string", "minLength": 1 },
        "joint_positions": {
          "type": "object",
          "maxProperties": 512,
          "additionalProperties": { "type": "number" }
        },
        "cameras": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "object" }
        },
        "objects": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/worldObject" }
        },
        "scenario_time_ms": { "type": "integer", "minimum": 0 },
        "scenario_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "security": {
      "type": "object",
      "required": ["attestation_refs"],
      "additionalProperties": false,
      "properties": {
        "signature_ref": { "type": ["string", "null"] },
        "attestation_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sbom_ref": { "type": ["string", "null"] }
      }
    }
  }
}
