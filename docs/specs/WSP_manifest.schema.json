{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urdf.studio/specs/wsp/manifest-1.0.0.schema.json",
  "title": "World Scene Package Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "version",
    "title",
    "created_at",
    "runtime_targets",
    "interface",
    "artifacts",
    "world_snapshot",
    "provenance",
    "security"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_targets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["name", "mode"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["native", "python", "container"] },
          "min_version": { "type": "string" }
        }
      }
    },
    "interface": {
      "type": "object",
      "required": [
        "observation_modalities",
        "action_semantics",
        "timestep_ms",
        "frame_convention"
      ],
      "additionalProperties": true,
      "properties": {
        "observation_modalities": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "action_semantics": { "type": "string", "minLength": 1 },
        "timestep_ms": { "type": "integer", "minimum": 1 },
        "frame_convention": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["kind", "digest_sha256", "uri"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "digest_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "uri": { "type": "string", "minLength": 1 }
        }
      }
    },
    "world_snapshot": {
      "type": "object",
      "required": [
        "urdf_xml",
        "joint_positions",
        "cameras",
        "objects",
        "scenario_time_ms",
        "scenario_duration_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "urdf_xml": { "type": "string", "minLength": 1 },
        "joint_positions": {
          "type": "object",
          "maxProperties": 512,
          "additionalProperties": { "type": "number" }
        },
        "cameras": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "object" }
        },
        "objects": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "object" }
        },
        "scenario_time_ms": { "type": "integer", "minimum": 0 },
        "scenario_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "security": {
      "type": "object",
      "required": ["attestation_refs"],
      "additionalProperties": false,
      "properties": {
        "signature_ref": { "type": ["string", "null"] },
        "attestation_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sbom_ref": { "type": ["string", "null"] }
      }
    }
  }
}
