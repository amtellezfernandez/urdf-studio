<?xml version="1.0"?>
<!-- Auto-generated from 0-ship-crane.glb : fixed-base luffing crane.
     Scaled to 2.5% for URDF Studio's compact hk-cargo-port world. -->
<robot name="ship_crane">

  <!-- Anchor the crane to the world so it can't free-fall or tip over.
       The rpy roll of +90 deg stands the (Z-up) model upright in a Y-up
       viewer; it rotates the whole robot at the root, so every joint axis is
       untouched in its own link frame and the boom/yaw motion is unchanged.
       (In PyBullet you can equivalently pass useFixedBase=True.) -->
  <link name="world"/>
  <joint name="anchor" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.51" rpy="1.5707963 0 0"/>
  </joint>

  <link name="base_link"/>

  <!-- Keep the crane base fixed so SO101 teleop only drives the boom and gripper. -->
  <joint name="base_yaw" type="fixed">
    <parent link="base_link"/>
    <child link="tower_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tower_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/tower.glb" scale="0.025 0.025 0.025"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/tower.glb" scale="0.025 0.025 0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.0005 -0.141575 0.2649" rpy="0 0 0"/>
      <mass value="599566.4"/>
      <inertia ixx="69459188.1" iyy="30286548.9" izz="46266288.5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Joint 1: luff the boom up/down about its heel (worldX axis) -->
  <joint name="boom_luff" type="revolute">
    <parent link="tower_link"/>
    <child link="boom_link"/>
    <origin xyz="0.001175 0.010025 0.286075" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.6" upper="1.2" effort="5.0e7" velocity="0.2"/>
  </joint>

  <link name="boom_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/boom.glb" scale="0.025 0.025 0.025"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/boom.glb" scale="0.025 0.025 0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.00075 0.1405 0.264875" rpy="0 0 0"/>
      <mass value="22.2"/>
      <inertia ixx="6121.0" iyy="5516.0" izz="1135.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- =====================================================================
       1-DOF gripper at the FAR end of the boom (mast peak, the end furthest
       from the crane body). Not a real crane spreader, but it has the physics
       of a single-actuator gripper so it transfers to a real gripper arm:
         gripper_palm : fixed to the boom far end; carries one FIXED jaw
         finger_link  : the one moving jaw (prismatic) -> the single DOF
       Drive `finger_slide` only: 0 = closed, 0.8 = open.
       ===================================================================== -->
  <material name="gripper_gray"><color rgba="0.25 0.27 0.3 1"/></material>

  <joint name="gripper_mount" type="fixed">
    <parent link="boom_link"/>
    <child link="gripper_palm"/>
    <origin xyz="0 0.09 0.61" rpy="0 0 0"/>
  </joint>

  <link name="gripper_palm">
    <!-- wrist plate -->
    <visual>
      <origin xyz="0 0 0.00625" rpy="0 0 0"/>
      <geometry><box size="0.045 0.03 0.0125"/></geometry>
      <material name="gripper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.00625" rpy="0 0 0"/>
      <geometry><box size="0.045 0.03 0.0125"/></geometry>
    </collision>
    <!-- fixed jaw (rigid part of the palm) -->
    <visual>
      <origin xyz="-0.01375 0 0.035" rpy="0 0 0"/>
      <geometry><box size="0.0075 0.025 0.045"/></geometry>
      <material name="gripper_gray"/>
    </visual>
    <collision>
      <origin xyz="-0.01375 0 0.035" rpy="0 0 0"/>
      <geometry><box size="0.0075 0.025 0.045"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.0316" iyy="0.0405" izz="0.0223" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- the single degree of freedom: one moving jaw -->
  <joint name="finger_slide" type="prismatic">
    <parent link="gripper_palm"/>
    <child link="finger_link"/>
    <origin xyz="-0.00625 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.02" effort="2000.0" velocity="0.5"/>
  </joint>

  <link name="finger_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry><box size="0.0075 0.025 0.045"/></geometry>
      <material name="gripper_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry><box size="0.0075 0.025 0.045"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <mass value="0.013"/>
      <inertia ixx="0.00265" iyy="0.00208" izz="0.000681" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
