{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/*": ["web/src/*"],
      "@runtime-private/*": ["runtime/*"],
      "i-love-urdf": ["node_modules/i-love-urdf/dist/index.d.ts"],
      "i-love-urdf/browser": ["node_modules/i-love-urdf/dist/browser.d.ts"]
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": false,
    "strictNullChecks": false
  }
}
